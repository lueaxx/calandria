.venv/
__pycache__/
*.pyc
.scratch/
.env
*.egg-info/
.pytest_cache/
transcripts/
# The synthetic samples are generated by scripts/make_samples.py and carry no
# third-party rights, so they are tracked. Talks fetched from YouTube are not:
# a conference recording's licence does not permit redistributing it inside an
# Apache-2.0 repository, whatever the licence says about watching it.
samples/talk-*.wav
samples/talk-*.txt
!samples/README.md
transcripts/

# service account keys - NUNCA commitear
*.sa.json
gcp-key.json

# El video del demo contiene metraje de una charla de Nerdearla. Usarlo esta
# autorizado por las bases; redistribuirlo dentro de un repo Apache-2.0 no.
video/*.mp4
video/*.webm
